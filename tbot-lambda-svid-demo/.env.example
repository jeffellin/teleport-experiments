# Configuration for demo-walkthrough.ipynb
# Copy this file to .env and edit. The notebook creates it for you on first run.
#
#   cp .env.example .env

# REQUIRED: your Teleport proxy address, including the port.
TELEPORT_PROXY_ADDR=example.teleport.sh:443

# Address tctl connects to -- usually the same as TELEPORT_PROXY_ADDR.
# Leave blank to reuse it.
#
# Both exist because tsh reads TELEPORT_PROXY while tctl ignores that and reads
# TELEPORT_AUTH_SERVER. The notebook exports both explicitly so every tsh/tctl
# call targets this cluster. That matters if you're logged into several proxies:
# otherwise they follow ~/.tsh/current-profile, and exporting the wrong cluster's
# SPIFFE CA makes Postgres reject every SVID while all the config still looks
# correct.
TELEPORT_AUTH_SERVER=

# AWS region for every created resource.
AWS_REGION=us-east-1

# Base name for the Lambda, IAM role, bot, token, and workload identity.
DEMO_NAME=tbot-svid-demo

# Build architecture: arm64 (default, cheapest) or amd64.
ARCH=arm64

# Leave blank to auto-discover a VPC containing a public subnet.
VPC_ID=
SUBNET_ID=

# Leave blank to auto-detect your public IP as a /32 for the SSH rule.
# Set this explicitly if your IP changes often or you're behind a shared egress.
ADMIN_CIDR=

# --- AWS credentials ---------------------------------------------------------
# Only set these if your credentials aren't already available elsewhere. The
# notebook uses the standard chain first: ~/.aws/credentials, `aws sso login`,
# an instance profile, or AWS_* already exported in your shell. If that works,
# leave all of this commented out.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Alternatively, point at a file of AWS_* exports kept outside the repo:
# AWS_ENV_FILE=~/.aws.env
#
# .env is gitignored. Prefer short-lived credentials (SSO, assumed role) over
# long-lived IAM user keys -- this file sits inside the repo.

# TELEPORT_VERSION is deliberately absent: the notebook reads it from your live
# cluster so the tbot binary it ships always matches the cluster's major version.
